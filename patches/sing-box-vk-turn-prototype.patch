+++ b/protocol/vkturn/config_test.go
@@ -0,0 +1,58 @@
+package vkturn
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestConfigurationPreservesRoutingAndUsesNativeWireGuard(t *testing.T) {
+	route := json.RawMessage(`{"rules":[{"domain":["example.org"],"outbound":"vk-wg"},{"ip_is_private":true,"outbound":"direct"},{"port":25,"action":"reject"}],"final":"vk-wg"}`)
+	wg := WireGuardConfig{PrivateKey: strings.Repeat("A", 43) + "=", PublicKey: strings.Repeat("A", 43) + "=", Address: "10.0.0.2/32", MTU: 1280}
+	text, err := BuildConfiguration(route, &wg, 7)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var c struct {
+		Route     json.RawMessage `json:"route"`
+		Endpoints []struct {
+			Type, Tag, Detour string
+			System            bool
+		}
+		Outbounds []struct {
+			Type, Tag string
+			Session   int64
+		}
+	}
+	if err := json.Unmarshal([]byte(text), &c); err != nil {
+		t.Fatal(err)
+	}
+	if string(c.Route) != string(route) {
+		t.Fatalf("routing changed: %s", c.Route)
+	}
+	if len(c.Endpoints) != 1 || c.Endpoints[0].Type != "wireguard" || c.Endpoints[0].Detour != "vk-transport" || c.Endpoints[0].System {
+		t.Fatalf("not native userspace WireGuard: %+v", c.Endpoints)
+	}
+	if len(c.Outbounds) != 2 || c.Outbounds[1].Type != "vk-turn-transport" || c.Outbounds[1].Session != 7 {
+		t.Fatalf("missing transport: %+v", c.Outbounds)
+	}
+}
+
+func TestBaselineHasNoWireGuardOrTURN(t *testing.T) {
+	text, err := BuildConfiguration(json.RawMessage(`{"final":"vk-wg"}`), nil, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(text, "wireguard") || strings.Contains(text, "vk-turn-transport") {
+		t.Fatal("baseline starts extra engines")
+	}
+	if !strings.Contains(text, `"tag":"vk-wg"`) {
+		t.Fatal("baseline loses route target")
+	}
+}
+
+func TestInvalidRoutingRejected(t *testing.T) {
+	if _, err := BuildConfiguration(json.RawMessage(`{"final":`), nil, 0); err == nil {
+		t.Fatal("accepted invalid routing")
+	}
+}
diff --git a/protocol/vkturn/outbound.go b/protocol/vkturn/outbound.go
new file mode 100644
index 00000000..37658dc9
--- /dev/null
+++ b/protocol/vkturn/outbound.go
@@ -0,0 +1,104 @@
+package vkturn
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/cacggghp/vk-turn-proxy/pkg/proxy"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/adapter/outbound"
+	"github.com/sagernet/sing-box/log"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+var sessionsMu sync.Mutex
+var sessions = make(map[int64]*proxy.Proxy)
+var nextSession atomic.Int64
+var generation int64
+
+func BeginSession() int64 {
+	sessionsMu.Lock()
+	defer sessionsMu.Unlock()
+	generation++
+	return generation
+}
+
+func AddSession(p *proxy.Proxy, expectedGeneration int64) (int64, error) {
+	sessionsMu.Lock()
+	if expectedGeneration != generation {
+		sessionsMu.Unlock()
+		return 0, fmt.Errorf("VK TURN startup cancelled")
+	}
+	id := nextSession.Add(1)
+	sessions[id] = p
+	sessionsMu.Unlock()
+	return id, nil
+}
+func StopSession(id int64) {
+	sessionsMu.Lock()
+	p := sessions[id]
+	delete(sessions, id)
+	sessionsMu.Unlock()
+	if p != nil {
+		p.StopWithTimeout(3 * time.Second)
+	}
+}
+
+type Options struct {
+	Session int64 `json:"session"`
+}
+type Outbound struct {
+	outbound.Adapter
+	proxy *proxy.Proxy
+}
+
+func RegisterOutbound(registry *outbound.Registry) {
+	outbound.Register[Options](registry, "vk-turn-transport", NewOutbound)
+}
+func NewOutbound(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, options Options) (adapter.Outbound, error) {
+	sessionsMu.Lock()
+	p := sessions[options.Session]
+	sessionsMu.Unlock()
+	if p == nil {
+		return nil, fmt.Errorf("VK TURN session is not prepared")
+	}
+	return &Outbound{Adapter: outbound.NewAdapter("vk-turn-transport", tag, []string{N.NetworkUDP}, nil), proxy: p}, nil
+}
+func (o *Outbound) DialContext(_ context.Context, network string, _ M.Socksaddr) (net.Conn, error) {
+	if network != N.NetworkUDP {
+		return nil, fmt.Errorf("VK TURN transport accepts WireGuard UDP packets only")
+	}
+	return newPacketConn(o.proxy), nil
+}
+func (o *Outbound) ListenPacket(_ context.Context, _ M.Socksaddr) (net.PacketConn, error) {
+	return newPacketConn(o.proxy), nil
+}
+
+// CancelSessions also cancels bootstrap before its handle has reached Swift.
+func CancelSessions() {
+	sessionsMu.Lock()
+	generation++
+	ids := make([]int64, 0, len(sessions))
+	for id := range sessions {
+		ids = append(ids, id)
+	}
+	sessionsMu.Unlock()
+	for _, id := range ids {
+		StopSession(id)
+	}
+}
+
+func SessionStats(id int64) proxy.Stats {
+	sessionsMu.Lock()
+	p := sessions[id]
+	sessionsMu.Unlock()
+	if p == nil {
+		return proxy.Stats{}
+	}
+	return p.GetStats()
+}
diff --git a/protocol/vkturn/packet.go b/protocol/vkturn/packet.go
new file mode 100644
index 00000000..e577fe57
--- /dev/null
+++ b/protocol/vkturn/packet.go
@@ -0,0 +1,139 @@
+package vkturn
+
+import (
+	"net"
+	"os"
+	"sync"
+	"time"
+)
+
+type packetTransport interface {
+	SendPacketUntil(<-chan struct{}, []byte) error
+	ReceivePacketUntil(<-chan struct{}, []byte) (int, error)
+}
+
+type receivedPacket struct {
+	data []byte
+	err  error
+}
+
+type packetConn struct {
+	transport       packetTransport
+	done            chan struct{}
+	closeOnce       sync.Once
+	incoming        chan receivedPacket
+	mu              sync.Mutex
+	readDeadline    time.Time
+	writeDeadline   time.Time
+	deadlineChanged chan struct{}
+}
+
+func newPacketConn(p packetTransport) *packetConn {
+	c := &packetConn{transport: p, done: make(chan struct{}), incoming: make(chan receivedPacket, 1), deadlineChanged: make(chan struct{})}
+	go c.receive()
+	return c
+}
+
+func (c *packetConn) receive() {
+	b := make([]byte, 65535)
+	for {
+		n, err := c.transport.ReceivePacketUntil(c.done, b)
+		item := receivedPacket{err: err}
+		if n > 0 {
+			item.data = append([]byte(nil), b[:n]...)
+		}
+		select {
+		case c.incoming <- item:
+		case <-c.done:
+			return
+		}
+		if err != nil {
+			return
+		}
+	}
+}
+
+func (c *packetConn) Read(b []byte) (int, error) { n, _, err := c.ReadFrom(b); return n, err }
+func (c *packetConn) ReadFrom(b []byte) (int, net.Addr, error) {
+	for {
+		c.mu.Lock()
+		deadline, changed := c.readDeadline, c.deadlineChanged
+		c.mu.Unlock()
+		var timer *time.Timer
+		var timeout <-chan time.Time
+		if !deadline.IsZero() {
+			if !time.Now().Before(deadline) {
+				return 0, nil, os.ErrDeadlineExceeded
+			}
+			timer = time.NewTimer(time.Until(deadline))
+			timeout = timer.C
+		}
+		select {
+		case <-c.done:
+			if timer != nil {
+				timer.Stop()
+			}
+			return 0, nil, net.ErrClosed
+		case <-changed:
+			if timer != nil {
+				timer.Stop()
+			}
+			continue
+		case <-timeout:
+			return 0, nil, os.ErrDeadlineExceeded
+		case item := <-c.incoming:
+			if timer != nil {
+				timer.Stop()
+			}
+			return copy(b, item.data), c.RemoteAddr(), item.err
+		}
+	}
+}
+func (c *packetConn) Write(b []byte) (int, error) {
+	select {
+	case <-c.done:
+		return 0, net.ErrClosed
+	default:
+	}
+	c.mu.Lock()
+	deadline := c.writeDeadline
+	c.mu.Unlock()
+	if !deadline.IsZero() && !time.Now().Before(deadline) {
+		return 0, os.ErrDeadlineExceeded
+	}
+	// Native WireGuard does not set transport write deadlines. Closing this
+	// connection also unblocks a send waiting for room in the TURN queue.
+	if err := c.transport.SendPacketUntil(c.done, b); err != nil {
+		return 0, err
+	}
+	return len(b), nil
+}
+func (c *packetConn) WriteTo(b []byte, _ net.Addr) (int, error) { return c.Write(b) }
+func (c *packetConn) Close() error                              { c.closeOnce.Do(func() { close(c.done) }); return nil }
+func (c *packetConn) LocalAddr() net.Addr                       { return &net.UDPAddr{IP: net.IPv4zero} }
+func (c *packetConn) RemoteAddr() net.Addr {
+	return &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 51820}
+}
+func (c *packetConn) SetDeadline(t time.Time) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.readDeadline = t
+	c.writeDeadline = t
+	close(c.deadlineChanged)
+	c.deadlineChanged = make(chan struct{})
+	return nil
+}
+func (c *packetConn) SetReadDeadline(t time.Time) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.readDeadline = t
+	close(c.deadlineChanged)
+	c.deadlineChanged = make(chan struct{})
+	return nil
+}
+func (c *packetConn) SetWriteDeadline(t time.Time) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.writeDeadline = t
+	return nil
+}
diff --git a/protocol/vkturn/packet_test.go b/protocol/vkturn/packet_test.go
new file mode 100644
index 00000000..a2a230ed
--- /dev/null
+++ b/protocol/vkturn/packet_test.go
@@ -0,0 +1,67 @@
+package vkturn
+
+import (
+	"errors"
+	"net"
+	"os"
+	"testing"
+	"time"
+)
+
+type testPackets struct{ packets chan []byte }
+
+func (p *testPackets) SendPacketUntil(done <-chan struct{}, b []byte) error {
+	select {
+	case p.packets <- append([]byte(nil), b...):
+		return nil
+	case <-done:
+		return net.ErrClosed
+	}
+}
+func (p *testPackets) ReceivePacketUntil(done <-chan struct{}, b []byte) (int, error) {
+	select {
+	case v := <-p.packets:
+		return copy(b, v), nil
+	case <-done:
+		return 0, net.ErrClosed
+	}
+}
+
+func TestPacketRoundTripAndClose(t *testing.T) {
+	p := &testPackets{make(chan []byte, 1)}
+	c := newPacketConn(p)
+	if _, err := c.Write([]byte("wireguard-packet")); err != nil {
+		t.Fatal(err)
+	}
+	b := make([]byte, 128)
+	n, addr, err := c.ReadFrom(b)
+	if err != nil || string(b[:n]) != "wireguard-packet" || addr.String() != "127.0.0.1:51820" {
+		t.Fatalf("n=%d addr=%v err=%v", n, addr, err)
+	}
+	done := make(chan error, 1)
+	go func() { _, err := c.Read(b); done <- err }()
+	c.Close()
+	select {
+	case err := <-done:
+		if !errors.Is(err, net.ErrClosed) {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("Close did not unblock read")
+	}
+}
+
+func TestReadDeadlineAndRecovery(t *testing.T) {
+	p := &testPackets{make(chan []byte, 1)}
+	c := newPacketConn(p)
+	defer c.Close()
+	c.SetReadDeadline(time.Now().Add(10 * time.Millisecond))
+	if _, err := c.Read(make([]byte, 64)); !errors.Is(err, os.ErrDeadlineExceeded) {
+		t.Fatalf("expected deadline: %v", err)
+	}
+	c.SetReadDeadline(time.Time{})
+	c.Write([]byte("after-timeout"))
+	if _, err := c.Read(make([]byte, 64)); err != nil {
+		t.Fatal(err)
+	}
+}
