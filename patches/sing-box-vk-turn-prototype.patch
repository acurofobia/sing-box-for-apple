+package libbox
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestVLESSPrototypeStartsWithoutTURNSettings(t *testing.T) {
+	session, err := StartVKTurnPrototype(`{"mode":"vless","route":{"final":"vk-wg"},"vless":{"type":"vless","server":"127.0.0.1","server_port":443,"uuid":"bf000d23-0752-40b4-affe-68f7707a9661"}}`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if session.ID != 0 {
+		t.Fatal("VLESS created a TURN session")
+	}
+	if !strings.Contains(session.Configuration, `"type":"vless"`) {
+		t.Fatal("VLESS not selected")
+	}
+	if strings.Contains(session.Configuration, "wireguard") || strings.Contains(session.Configuration, "vk-turn-transport") {
+		t.Fatal("VLESS contains TURN or WireGuard")
+	}
+	var config map[string]json.RawMessage
+	if err := json.Unmarshal([]byte(session.Configuration), &config); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestVLESSPrototypeRejectsMissingOutbound(t *testing.T) {
+	if _, err := StartVKTurnPrototype(`{"mode":"vless","route":{"final":"vk-wg"}}`); err == nil {
+		t.Fatal("accepted missing VLESS configuration")
+	}
+}
diff --git a/experimental/libbox/internal/oomprofile/oomprofile_test.go b/experimental/libbox/internal/oomprofile/oomprofile_test.go
new file mode 100644
index 00000000..0229f6d7
--- /dev/null
+++ b/experimental/libbox/internal/oomprofile/oomprofile_test.go
@@ -0,0 +1,53 @@
+//go:build darwin || linux || windows
+
+package oomprofile
+
+import (
+	"google.golang.org/protobuf/encoding/protowire"
+	"os"
+	"path/filepath"
+	"runtime"
+	"testing"
+)
+
+var sampledAllocation []byte
+
+func TestAllOOMProfilesReadCurrentRuntimeRecords(t *testing.T) {
+	previousRate := runtime.MemProfileRate
+	runtime.MemProfileRate = 1
+	defer func() { runtime.MemProfileRate = previousRate }()
+	sampledAllocation = make([]byte, 4096)
+	defer func() { sampledAllocation = nil }()
+	runtime.GC()
+	for _, name := range []string{"allocs", "heap", "block", "mutex", "goroutine", "threadcreate"} {
+		t.Run(name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), name+".pb.gz")
+			if err := WriteFile(path, name); err != nil {
+				t.Fatal(err)
+			}
+			data, err := os.ReadFile(path)
+			if err != nil || len(data) == 0 {
+				t.Fatalf("empty or missing profile: %v", err)
+			}
+			samples := 0
+			for len(data) > 0 {
+				number, typ, count := protowire.ConsumeTag(data)
+				if count < 0 {
+					t.Fatal("invalid protobuf tag")
+				}
+				data = data[count:]
+				count = protowire.ConsumeFieldValue(number, typ, data)
+				if count < 0 {
+					t.Fatal("invalid protobuf field")
+				}
+				if int(number) == tagProfile_Sample {
+					samples++
+				}
+				data = data[count:]
+			}
+			if (name == "heap" || name == "allocs") && samples == 0 {
+				t.Fatal("allocation profile lost all samples")
+			}
+		})
+	}
+}
